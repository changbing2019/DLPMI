    given-names: Changbing
    affiliation: "Environmental Data Techniques, Inc."
    email: yangcb@gmail.com
version: 2.0.0
license: MIT
repository-code: "https://github.com/changbing2019/DLPMI"
keywords:
  - groundwater age
  - environmental tracers
  - lumped-parameter models
  - identifiability
  - automatic differentiation
